# Copia este archivo a .env y rellena valores reales.
# Nunca subas .env a Git (ya está en .gitignore).

# PostgreSQL (coincide con docker-compose por defecto)
POSTGRES_USER=athenea
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=athenea_db

# Auth
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
AUTH_DATABASE_URL=postgresql://athenea:cambia_esto_en_produccion@postgres:5432/athenea_db

# Redis
REDIS_URL=redis://redis:6379

# MongoDB: Atlas en producción; en local puedes usar mongodb://mongo:27017/athenea_clinic
MONGODB_URI=mongodb://mongo:27017/athenea_clinic

# URLs internas para el gateway (Docker)
AUTH_SERVICE_URL=http://auth-service:4001
CLINICAL_SERVICE_URL=http://clinical-service:4002
IA_SERVICE_URL=http://ia-service:4003
